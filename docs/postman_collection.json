{
  "info": {
    "name": "Peaje IA · Sistema Inteligente de Control de Peaje",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Variables: BASE_URL (subdominio HTTPS), TOKEN (Bearer de /auth/google), GOOGLE_ID_TOKEN, HARDWARE_TOKEN, INFERENCE_URL, INFERENCE_TOKEN."
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "https://peaje.tu-dominio.com"
    },
    {
      "key": "TOKEN",
      "value": ""
    },
    {
      "key": "GOOGLE_ID_TOKEN",
      "value": ""
    },
    {
      "key": "HARDWARE_TOKEN",
      "value": ""
    },
    {
      "key": "CASETA_ID",
      "value": "1"
    },
    {
      "key": "INFERENCE_URL",
      "value": "https://POD_ID-8000.proxy.runpod.net"
    },
    {
      "key": "INFERENCE_TOKEN",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login con Google ID Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/google",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ]
            },
            "description": "200 -> guarda TOKEN automáticamente. 403 -> 'Acceso denegado: cuenta no autorizada'.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{GOOGLE_ID_TOKEN}}\",\n  \"dispositivo\": \"postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('TOKEN', pm.response.json().token); }",
                  "pm.test('200 o 403', () => pm.expect([200, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/yo",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "yo"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cerrar sesión (revoca token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/logout",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
