# ============================================================
#  Servidor de inferencia (RunPod / Colab) — PLANTILLA
#  Copie a .env (NO se versiona) o defina las variables en el Pod:
#  RunPod > Edit Pod > Environment Variables
# ============================================================

# Token compartido con Laravel (Panel > Estado del sistema > INFERENCE_TOKEN)
# Genere uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=cambie-este-token

PORT=8000
DEVICE=auto

# Pesos entrenados en Colab (si no existen se usa el modo fallback preentrenado)
M2_PESOS=pesos/m2_vehiculos_seg.pt
M3_PESOS=pesos/m3_llantas_pose.pt
M4_PESOS=pesos/m4_pasajeros_seg.pt

# Fallbacks preentrenados
M2_FALLBACK=yolo11s-seg.pt
M4_FALLBACK=yolo11s-seg.pt
M3_USAR_YOLOE=1
M3_FALLBACK_YOLOE=yoloe-11s-seg.pt

# Umbrales
M1_UMBRAL=0.40
M2_UMBRAL=0.35
M3_UMBRAL=0.25
M4_UMBRAL=0.35
M4_MIN_INTERSECCION=0.30
