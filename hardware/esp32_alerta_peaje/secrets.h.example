#pragma once

// Red Wi-Fi (2.4 GHz). En la demo puede usar el hotspot del celular.
#define WIFI_SSID      "NOMBRE_DE_SU_WIFI"
#define WIFI_PASSWORD  "CONTRASENA_WIFI"

// Subdominio HTTPS de producción, SIN "https://" y SIN "/" final
#define API_HOST       "peaje.tu-dominio.com"

// Debe coincidir con HARDWARE_TOKEN del .env de Laravel
#define HARDWARE_TOKEN "pegue-aqui-el-HARDWARE_TOKEN"

// ID de la caseta que vigila este dispositivo (Panel > Casetas)
#define CASETA_ID      "1"

// true = buzzer pasivo (tono PWM) · false = buzzer activo (módulo con oscilador)
#define BUZZER_PASIVO  true

// Certificado raíz del subdominio (recomendado). Obténgalo con:
//   openssl s_client -showcerts -connect peaje.tu-dominio.com:443 </dev/null
// y copie el ÚLTIMO bloque (raíz, p. ej. ISRG Root X1 de Let's Encrypt).
// Si lo deja vacío ("") se usa setInsecure(): la conexión va cifrada pero sin validar el certificado.
static const char ROOT_CA[] = "";
