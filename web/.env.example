# =====================================================================
#  Sistema Inteligente de Control de Peaje — Laravel 12 (PLANTILLA)
#  cp .env.example .env && php artisan key:generate
#  NUNCA suba .env al repositorio.
# =====================================================================
APP_NAME="Peaje IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://peaje.tu-dominio.com
# En APP_ENV=production todas las URLs se generan con https (proxy de Render/Cloudflare/Nginx).
# FORCE_HTTPS=true fuerza lo mismo en otros entornos (p. ej. staging).
FORCE_HTTPS=false
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Render/Docker: LOG_CHANNEL=stderr para ver los logs en el panel
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------- Base de datos: SQLite (simple), MySQL (hosting/VPS) o PostgreSQL (Render) ----------
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/database/database.sqlite
# --- Render (PostgreSQL gestionado): pegue la "Internal Database URL" ---
# DB_CONNECTION=pgsql
# DB_URL=postgresql://peaje:<password>@<host-interno>/peaje_ia
# DB_SSLMODE=prefer
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=peaje_ia
# DB_USERNAME=peaje
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ---------- Lista blanca ----------
# El docente doc.alvaro.pinto.ma@unifranz.edu.bo se precarga SIEMPRE como administrador.
ADMIN_EMAIL=su-correo@gmail.com
OPERADOR_EMAIL=

# ---------- Google OAuth 2.0 (Google Cloud Console) ----------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Client IDs adicionales aceptados como 'aud' del ID Token (separados por coma)
GOOGLE_CLIENT_IDS_EXTRA=

# ---------- Servidor de inferencia (también editable en Panel > Estado del sistema) ----------
INFERENCE_URL=https://POD_ID-8000.proxy.runpod.net
INFERENCE_TOKEN=
INFERENCE_TIMEOUT=30

# ---------- ESP32 (header X-Hardware-Token) ----------
HARDWARE_TOKEN=
HARDWARE_VIGENCIA_SEGUNDOS=12

# ---------- Reglas del peaje ----------
PEAJE_DEDUP_SEGUNDOS=60
PEAJE_UMBRAL_PLACA=0.45
PEAJE_PRIORIDAD_CATEGORIA=ia

# ---------- Tiempo real: Pusher (por defecto) o Reverb ----------
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2

# Reverb (VPS): BROADCAST_CONNECTION=reverb + composer require laravel/reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=ws.peaje.tu-dominio.com
REVERB_PUBLIC_PORT=443

# ---------- Agente conversacional ----------
# gemini | openai | groq | ollama | ninguno  (sin API key -> respaldo determinista)
AGENTE_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=https://POD_ID-11434.proxy.runpod.net/v1
OLLAMA_MODEL=qwen2.5:14b

MAIL_MAILER=log
