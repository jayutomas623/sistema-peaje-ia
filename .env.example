# =====================================================================
#  Índice de variables por servicio (PLANTILLA — sin secretos reales)
#  Cada servicio tiene su propia plantilla:
#    web/.env.example                       -> Laravel (Google OAuth, Pusher, Gemini, INFERENCE_*, HARDWARE_TOKEN)
#    inferencia/.env.example                -> FastAPI en RunPod/Colab (API_TOKEN, pesos, umbrales)
#    hardware/esp32_alerta_peaje/secrets.h.example -> ESP32 (Wi-Fi, API_HOST, HARDWARE_TOKEN)
#    movil: --dart-define=API_BASE_URL=... --dart-define=GOOGLE_SERVER_CLIENT_ID=...
# =====================================================================

# Valores que deben COINCIDIR entre servicios:
#   inferencia API_TOKEN          == web INFERENCE_TOKEN
#   web HARDWARE_TOKEN            == ESP32 HARDWARE_TOKEN
#   web GOOGLE_CLIENT_ID          == movil GOOGLE_SERVER_CLIENT_ID (Web Client ID)
#   web APP_URL (host)            == ESP32 API_HOST == movil API_BASE_URL

APP_URL=https://peaje.tu-dominio.com
INFERENCE_URL=https://POD_ID-8000.proxy.runpod.net
INFERENCE_TOKEN=
HARDWARE_TOKEN=
GOOGLE_CLIENT_ID=
